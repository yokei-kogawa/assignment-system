// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending_assignment
  assigned
  in_progress
  completed
  unassigned
  reassignment_required
}

model User {
  id Int @id @default(autoincrement())

  employeeCode String @unique

  name String

  email String @unique

  role String

  isActive Boolean @default(true)

  createdAt DateTime

  updatedAt DateTime

  createdOrders               Order[]
  orderAssignments            OrderAssignment[]   @relation("AssignedUser")
  createdAssignments          OrderAssignment[]   @relation("AssignmentCreator")
  salesGroupMemberships       SalesGroupMember[]
  changedOrderHistories       OrderHistory[]
  previousAssignmentHistories AssignmentHistory[] @relation("PreviousAssignedUser")
  newAssignmentHistories      AssignmentHistory[] @relation("NewAssignedUser")
  changedAssignmentHistories  AssignmentHistory[] @relation("AssignmentChangedBy")
  createdDiscussions          Discussion[]
  discussionMessages          DiscussionMessage[]
}

model Customer {
  id Int @id @default(autoincrement())

  customerCode String @unique

  companyName String

  country String

  isActive Boolean @default(true)

  createdAt DateTime

  updatedAt DateTime

  orders Order[]
}

model SalesGroup {
  id Int @id @default(autoincrement())

  groupCode String @unique

  groupName String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime

  updatedAt DateTime

  assignedOrders  Order[]
  members         SalesGroupMember[]
  assignmentRules AssignmentRule[]
}

model Order {
  id Int @id @default(autoincrement())

  orderNumber String @unique

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  assignedSalesGroupId Int?
  assignedSalesGroup   SalesGroup? @relation(fields: [assignedSalesGroupId], references: [id])

  status OrderStatus

  orderTitle String

  notes String?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime

  updatedAt DateTime

  assignments         OrderAssignment[]
  histories           OrderHistory[]
  assignmentHistories AssignmentHistory[]
  discussions         Discussion[]
}

enum AssignmentType {
  primary
  secondary
  support
}

model OrderAssignment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  userId Int
  user   User @relation("AssignedUser", fields: [userId], references: [id])

  assignmentType AssignmentType

  assignedById Int?
  assignedBy   User? @relation("AssignmentCreator", fields: [assignedById], references: [id])

  assignedAt DateTime

  isActive Boolean @default(true)

  @@unique([orderId, userId, assignmentType])
}

model SalesGroupMember {
  id Int @id @default(autoincrement())

  salesGroupId Int
  salesGroup   SalesGroup @relation(fields: [salesGroupId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  role String

  isActive Boolean @default(true)

  createdAt DateTime

  @@unique([salesGroupId, userId])
}

model AssignmentRule {
  id Int @id @default(autoincrement())

  salesGroupId Int
  salesGroup   SalesGroup @relation(fields: [salesGroupId], references: [id])

  priority Int

  isActive Boolean @default(true)

  createdAt DateTime

  updatedAt DateTime

  conditions AssignmentRuleCondition[]
}

model AssignmentRuleCondition {
  id Int @id @default(autoincrement())

  assignmentRuleId Int
  assignmentRule   AssignmentRule @relation(fields: [assignmentRuleId], references: [id])

  fieldName String

  expectedValue String

  priority Int

  isEnabled Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime

  updatedAt DateTime

  @@unique([assignmentRuleId, fieldName])
}

model OrderHistory {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  actionType String

  changedById Int
  changedBy   User @relation(fields: [changedById], references: [id])

  beforeData Json?

  afterData Json?

  createdAt DateTime
}

model AssignmentHistory {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  previousUserId Int?
  previousUser   User? @relation("PreviousAssignedUser", fields: [previousUserId], references: [id])

  newUserId Int
  newUser   User @relation("NewAssignedUser", fields: [newUserId], references: [id])

  changeType String

  changedById Int
  changedBy   User @relation("AssignmentChangedBy", fields: [changedById], references: [id])

  createdAt DateTime
}

model Discussion {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  title String

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime

  messages DiscussionMessage[]
}

model DiscussionMessage {
  id Int @id @default(autoincrement())

  discussionId Int
  discussion   Discussion @relation(fields: [discussionId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  message String

  createdAt DateTime

  updatedAt DateTime
}
